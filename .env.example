# vLLM
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT_SEC=300
VLLM_MAX_RETRIES=3

# Модель экстрактора
EXTRACTOR_MODEL_ID=numind/NuExtract3
EXTRACTOR_ENABLE_THINKING=true
EXTRACTOR_MAX_NEW_TOKENS=4096
EXTRACTOR_PAGE_BATCH_SIZE=1

# Модель детектора
DETECTOR_MODEL_ID=PaddlePaddle/PP-DocLayoutV3_safetensors
DETECTOR_DETECTION_THRESHOLD=0.3
DETECTOR_PAGE_BATCH_SIZE=1
DETECTOR_MODEL_DEVICE=auto

# Модель переводчика
TRANSLATOR_MODEL_ID=numind/NuExtract3
TRANSLATOR_ENABLE_THINKING=true
TRANSLATOR_MAX_NEW_TOKENS=4096
TRANSLATOR_PRODUCT_BATCH_SIZE=1

# Промпты
PROMPTS_DIR=src/prompts
EXTRACTION_PROMPT_VERSION=v1
TRANSLATION_PROMPT_VERSION=v1

# PDF converting
PDF_RENDER_DPI=200

# Paths
OUTPUT_DIR=data/products
CATALOGS_DIR=data/catalogs
NOMENCLATURE_DIR=data/nomenclature
NOMENCLATURE_TEMPLATE=data/nomenclature/template.xlsx

# API
API_HOST=0.0.0.0
API_PORT=8000

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
JOB_REPOSITORY_BACKEND=redis
